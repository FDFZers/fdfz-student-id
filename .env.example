POSTGRESQL_URL=postgres://student_id:student_id@localhost:5432/student_id?sslmode=disable
REDIS_URL=redis://localhost:6379/0
FILESTORE_PUBLIC_ENDPOINT=https://filestore.fdfz.top/
FILESTORE_INTERNAL_ENDPOINT=http://filestore:11411/
FILESTORE_HMAC_SECRET=change-me-to-a-long-random-string
NAPCAT_ENDPOINT=http://napcat:3000/
NAPCAT_TOKEN=
SHARED_DIR=
ALTCHA_HMAC_SECRET=change-me-to-a-long-random-string
JWT_KID=change-me-to-a-long-random-string
SMTP_HOST=mail.fdfz.top
SMTP_PORT=587
SMTP_FROM="FDFZ Bot <noreply@fdfz.top>"
SMTP_USERNAME=noreply@fdfz.top
SMTP_PASSWORD=
# 使用备用 SMTP 的收件人域名（精确匹配），逗号分隔；不区分大小写，可带 @
SMTP_BACKUP_DOMAINS=icloud.com,outlook.com
# 备用 SMTP：上述域名收件人使用；SMTP_BACKUP_HOST 留空时使用主 SMTP
# 启用时 SMTP_BACKUP_PASSWORD 必填；SMTP_BACKUP_FROM / SMTP_BACKUP_USERNAME 留空时沿用主 SMTP
SMTP_BACKUP_HOST=smtp.qq.com
SMTP_BACKUP_PORT=587
SMTP_BACKUP_FROM="FDFZ Bot <tigercrl@qq.top>"
SMTP_BACKUP_USERNAME=tigercrl@qq.top
SMTP_BACKUP_PASSWORD=
SCHOOL_IPS=
TRUSTED_PROXIES=
BYPASS_CAPTCHA=true
AUTH_FRONTEND_URL=https://auth.fdfz.top
OAUTH_ACCESS_TOKEN_TTL=30m
OAUTH_REFRESH_TOKEN_TTL=720h
OAUTH_CODE_TTL=60s
OAUTH_DEVICE_CODE_TTL=10m
OAUTH_CONSENT_REQUEST_TTL=10m
